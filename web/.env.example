# Copy to .env.local (git-ignored) and fill in. These values are PUBLIC by design (they ship in the
# browser bundle); security comes from Row Level Security, not from hiding them.
# NEVER put the service_role / secret key here.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon / publishable key
VITE_SUPABASE_ANON_KEY=

# Web Push public key. Generate the pair once with:  cd scripts && npm run vapid
VITE_VAPID_PUBLIC_KEY=

# Members log in with a username; Supabase Auth needs an email, so we append this domain.
# Must equal the LOGIN_EMAIL_DOMAIN secret used by the Edge Functions. Do not change after members exist.
VITE_LOGIN_EMAIL_DOMAIN=kulup.invalid
