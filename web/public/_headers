# Cloudflare Pages response headers.
# connect-src must list your Supabase project origin. The wildcard below covers *.supabase.co;
# tighten it to your exact project URL once it exists (see docs/RUNBOOK.md).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# The service worker and HTML must always revalidate so updates ship immediately.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Vite fingerprints everything under /assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
